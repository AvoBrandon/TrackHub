# Copy to .env. Leave blank anything you do not have yet; that connector shows as "not configured" in the app.
API_TOKEN=pick-a-long-random-string
TIMEZONE=America/New_York
HOME_AIRPORT=JFK

# Gmail: download OAuth client JSON from Google Cloud Console (Desktop app type)
GMAIL_CLIENT_SECRET_FILE=./secrets/gmail_client_secret.json

# Retail price watching
BESTBUY_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
KEEPA_API_KEY=

# Flights
AEROAPI_KEY=

# Hotels (optional)
HOTEL_API_BASE=
HOTEL_API_KEY=

# iPhone push
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_FILE=./secrets/AuthKey.p8
APNS_BUNDLE_ID=com.yourname.clawback
APNS_USE_SANDBOX=true
